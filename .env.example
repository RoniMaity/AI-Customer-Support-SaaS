# ==========================================
# 1. Server Configuration
# ==========================================
PORT=3000

# ==========================================
# 2. Database & Auth
# ==========================================
# PostgreSQL connection string (e.g., Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_saas?schema=public"

# Secret key used for signing JWT tokens for Admin Dashboard sessions
JWT_SECRET="generate_a_random_secure_string_here"

# ==========================================
# 3. AI & Embeddings
# ==========================================
# Used by embeddingService.ts to generate embeddings via sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_KEY="hf_..."

# Used by Chat Controller to generate LLM responses
GROK_API_KEY="xoxb-..."

# ==========================================
# 4. Vector Database (Pinecone)
# ==========================================
# Used to store and query document embeddings
PINECONE_API_KEY="pcsk_..."
PINECONE_INDEX_NAME="support-docs"

# ==========================================
# 5. Frontend / Widget Configs
# ==========================================
# Next.js public variables (set to your deployed Render backend URL)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ==========================================
# 6. CORS (Backend)
# ==========================================
# Comma-separated list of allowed origins (set to your Vercel frontend URL)
# Leave unset to allow all origins during testing
CORS_ORIGIN="https://your-frontend.vercel.app"
